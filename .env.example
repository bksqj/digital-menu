# PostgreSQL connection string (Neon/Supabase or local cluster).
# Neon: also set DIRECT_URL (non-pooled) for `prisma migrate` — see prisma.config.ts.
DATABASE_URL="postgresql://user:password@localhost:5432/digital_menu"
# DIRECT_URL="postgresql://user:password@localhost:5432/digital_menu"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Base URL used to build absolute links (QR codes, emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gemini vision API key (Google AI Studio) — reads uploaded menu photos/PDFs
# directly. Without it, lib/ocr falls back to MockOcrProvider.
# GOOGLE_API_KEY=""

# Resend API key — sends password-reset emails. Without it, reset requests
# still "succeed" (no account enumeration) but no email actually goes out;
# in dev the reset link is logged to the console instead.
# RESEND_API_KEY=""
